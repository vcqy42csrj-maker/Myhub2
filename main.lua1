-- FTAP TriggerBot - クロスヘア照準版 (1.2秒間隔固定、反応速度最適化、Qトグル)
-- 最適化内容: ループ方式変更、無駄な待機削除、クリック方式絞り込み、事前判定導入

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Workspace = game:GetService("Workspace")

local Player = Players.LocalPlayer
local Mouse = nil
repeat task.wait(0.05) Mouse = Player:GetMouse() until Mouse

local Character = Player.Character
local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

-- 設定
local ENABLED = true
local CLICK_INTERVAL = 1.2      -- 間隔制限は変更しない
local MAX_DISTANCE = 200

local isEnabled = ENABLED
local lastClickTime = 0
local renderConn = nil
local camera = Workspace.CurrentCamera

-- キャッシュ変数 (ループ内での再取得を削減)
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Blacklist

-- ターゲット判定 (高速化)
local function IsValidTarget(plr)
    if plr == Player then return false end
    local char = plr.Character
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end
    if humanoid.Health <= 0 then return false end
    return true
end

-- クロスヘアターゲット取得 (最適化版 - 無駄なループ削減、直接ヒット部分からプレイヤー解決)
local function GetTargetFromCrosshair()
    if not camera then return nil end
    if not HumanoidRootPart then return nil end
    
    local viewportSize = camera.ViewportSize
    local centerX = viewportSize.X / 2
    local centerY = viewportSize.Y / 2
    
    local ray = camera:ScreenPointToRay(centerX, centerY)
    params.FilterDescendantsInstances = {Character, camera}
    
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 500, params)
    if not hit then return nil end
    
    local hitPart = hit.Instance
    if not hitPart then return nil end
    
    -- 直接プレイヤー解決 (ループ回数削減)
    local current = hitPart
    for _ = 1, 4 do
        current = current.Parent
        if not current then break end
        local plr = Players:GetPlayerFromCharacter(current)
        if plr and IsValidTarget(plr) then
            local dist = (hitPart.Position - HumanoidRootPart.Position).Magnitude
            if dist <= MAX_DISTANCE then
                return plr
            end
            return nil
        end
    end
    
    return nil
end

-- クリック実行 (最速化 - 使用率の高い方式のみ、無駄な待機削減)
local function PerformClick()
    if not isEnabled then return end
    local now = os.clock()  -- tick() より高速な os.clock() を使用
    if now - lastClickTime < CLICK_INTERVAL then return end

    -- 方式1: 標準クリック (最速)
    pcall(function() Mouse:Click() end)
    
    -- 方式2: ダウン/アップ (待機時間を0.001秒に短縮)
    pcall(function()
        Mouse.Button1Down:Fire()
        task.wait(0.001)
        Mouse.Button1Up:Fire()
    end)
    
    -- 方式3: VirtualInputManager (待機時間短縮)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        task.wait(0.001)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)

    lastClickTime = now
    -- デバッグ出力を削除して速度向上 (必要に応じてコメント解除)
    -- print("[FTAP] クリック実行")
end

-- メインループ (RenderSteppedのみ使用 - 描画同期で最速)
local function MainLoop()
    if not isEnabled then return end
    
    local char = Player.Character
    if not char then return end
    local root = char.PrimaryPart
    if not root then return end
    HumanoidRootPart = root
    
    -- キャッシュされた HumanoidRootPart を使用
    if GetTargetFromCrosshair() then
        PerformClick()
    end
end

-- トグル (高速化のため出力簡略)
local function Toggle()
    isEnabled = not isEnabled
    print("[FTAP] " .. tostring(isEnabled))
end

-- ホットキー (3方式)
ContextActionService:BindAction("FTAP_Toggle", function(_, state)
    if state == Enum.UserInputState.Begin then Toggle() end
end, false, Enum.KeyCode.Q)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Q then
        Toggle()
    end
end)

Mouse.KeyDown:Connect(function(key)
    if key:lower() == "q" then Toggle() end
end)

-- ループ開始 (RenderSteppedのみ - 最も反応が速い)
if renderConn then renderConn:Disconnect() end
renderConn = RunService.RenderStepped:Connect(MainLoop)

print("[FTAP] 高速化版ロード完了 | 間隔: 1.2秒固定 | 距離: 200 | ホットキー: Q")
print("[FTAP] 最適化: RenderStepped専用, os.clock()使用, 待機0.001秒, デバッグ出力オフ")
print("[FTAP] 状態: " .. tostring(isEnabled))
