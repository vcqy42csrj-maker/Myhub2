local function shoulderCarry(topCharacter, bottomCharacter)
    local topTorso = topCharacter:FindFirstChild("Torso")
    local bottomTorso = bottomCharacter:FindFirstChild("Torso")

    if not topTorso or not bottomTorso then return end

    topCharacter:SetPrimaryPartCFrame(
        bottomTorso.CFrame * CFrame.new(0, 2.5, 0)
    )

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = topTorso
    weld.Part1 = bottomTorso
    weld.Parent = topTorso
end
