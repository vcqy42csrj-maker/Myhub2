local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local mouse = player:GetMouse()

local selectedPart = nil
local selecting = false

local Window = Rayfield:CreateWindow({
   Name = "Throw System",
   LoadingTitle = "Loading...",
   LoadingSubtitle = "Fixed Version",
   ConfigurationSaving = { Enabled = false }
})

local Tab = Window:CreateTab("Main", 4483362458)

-- 選択モード
Tab:CreateButton({
   Name = "選択モードON",
   Callback = function()
      selecting = true
      print("選択モードON")
   end
})

-- クリックで1回だけ取得
mouse.Button1Down:Connect(function()
   if not selecting then return end

   local target = mouse.Target
   if target and target:IsA("BasePart") then
      selectedPart = target
      selecting = false
      print("選択完了:", target.Name)
   end
end)

-- 飛ばす
Tab:CreateButton({
   Name = "敵に飛ばす",
   Callback = function()
      if not selectedPart then
         print("何も選択されてない")
         return
      end

      local closest
      local dist = math.huge

      for _, plr in pairs(Players:GetPlayers()) do
         if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local d = (plr.Character.HumanoidRootPart.Position - selectedPart.Position).Magnitude
            if d < dist then
               dist = d
               closest = plr
            end
         end
      end

      if not closest then return end

      local hrp = closest.Character.HumanoidRootPart

      local bv = Instance.new("BodyVelocity")
      bv.Velocity = (hrp.Position - selectedPart.Position).Unit * 120
      bv.MaxForce = Vector3.new(1e9,1e9,1e9)
      bv.Parent = selectedPart

      game.Debris:AddItem(bv, 0.3)

      print("発射した")
   end
})
